<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ title }} · Historische Linguistik</title>
<style>
  :root{
    --paper:#E7E1CE;
    --paper-raised:#EFEADA;
    --ink:#232F39;
    --ink-soft:#57646E;
    --ink-faint:#8A8F82;
    --rust:#A0432B;
    --rust-soft:#C97A5E;
    --river:#2C6E7F;
    --river-soft:#DCE9EA;
    --line:#B9AF93;
    --radius:10px;
    --serif: Iowan Old Style, Palatino Linotype, Palatino, Georgia, serif;
    --sans: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{background:var(--paper); color:var(--ink); font-family:var(--sans); line-height:1.5; -webkit-font-smoothing:antialiased;}
  .wrap{max-width:560px; margin:0 auto; padding:22px 18px 60px;}
  header.site{padding-bottom:18px; margin-bottom:22px; border-bottom:1px solid var(--line);}
  header.site .kicker{font-size:0.8rem; color:var(--rust); margin:0 0 6px;}
  h1{font-family:var(--serif); font-weight:600; font-size:clamp(1.4rem,6vw,1.8rem); margin:0 0 10px;}
  header.site p{margin:0; color:var(--ink-soft); font-size:0.95rem;}

  /* ── Settings menu (Über) ── */
  .settings-btn{
    position:fixed; top:14px; right:14px; z-index:250;
    width:38px; height:38px; border-radius:50%;
    background:var(--paper-raised);
    border:1px solid var(--line);
    color:var(--ink);
    font-size:19px; line-height:1;
    cursor:pointer;
    display:flex; align-items:center; justify-content:center;
    font-family:var(--sans);
    transition:border-color 0.25s, color 0.25s;
  }
  .settings-btn:hover, .settings-btn[aria-expanded="true"]{
    border-color:var(--river);
    color:var(--river);
  }
  .settings-menu{
    position:fixed; top:58px; right:14px; z-index:250;
    min-width:230px;
    background:var(--paper-raised);
    border:1px solid var(--line);
    border-radius:var(--radius);
    box-shadow:0 14px 34px rgba(35,47,57,0.18);
    padding:14px 16px;
    opacity:0; pointer-events:none;
    transform:translateY(-8px);
    transition:opacity 0.2s, transform 0.2s;
  }
  .settings-menu.open{ opacity:1; pointer-events:all; transform:translateY(0); }
  .settings-menu-title{
    font-size:0.68rem; letter-spacing:0.14em; text-transform:uppercase;
    color:var(--ink-faint);
    margin-bottom:8px; padding-bottom:6px;
    border-bottom:1px solid var(--line);
  }
  .settings-row{ font-family:var(--serif); font-size:0.95rem; color:var(--ink); margin-bottom:2px; }
  .settings-row-dim{ font-size:0.72rem; color:var(--ink-faint); margin-bottom:10px; }
  .settings-link{
    display:block; font-size:0.85rem; color:var(--river);
    text-decoration:none; padding:7px 0;
    border-top:1px solid var(--line);
    transition:color 0.2s;
  }
  .settings-link:hover, .settings-link:focus{ color:var(--rust); }
  @media (max-width:600px){
    .settings-menu{ right:10px; left:10px; min-width:auto; }
  }
</style>
</head>
<body>

<button class="settings-btn" id="settings-btn" type="button" aria-haspopup="true" aria-expanded="false" aria-controls="settings-menu" aria-label="Einstellungen &amp; Über">⋮</button>
<div class="settings-menu" id="settings-menu" role="menu" aria-hidden="true" aria-label="Über dieses Projekt">
  <div class="settings-menu-title">Über</div>
  <div class="settings-row">Grundlagen Linguistik</div>
  <div class="settings-row-dim">Stand: September 2026</div>
  <a class="settings-link" role="menuitem" href="https://s540d.github.io/impressum.html" target="_blank" rel="noopener noreferrer">Impressum</a>
  <a class="settings-link" role="menuitem" href="https://github.com/S540d/Grundlagen_Linguistik" target="_blank" rel="noopener noreferrer">Quellcode (GitHub)</a>
  <a class="settings-link" role="menuitem" href="https://github.com/S540d/Grundlagen_Linguistik/issues" target="_blank" rel="noopener noreferrer">Feedback / Kontakt</a>
</div>

<div class="wrap">
  {{ content | safe }}
</div>

<script>
(function () {
  var btn = document.getElementById("settings-btn");
  var menu = document.getElementById("settings-menu");
  function setOpen(open) {
    menu.classList.toggle("open", open);
    btn.setAttribute("aria-expanded", String(open));
    menu.setAttribute("aria-hidden", String(!open));
  }
  btn.addEventListener("click", function (e) {
    e.stopPropagation();
    setOpen(!menu.classList.contains("open"));
  });
  document.addEventListener("click", function (e) {
    if (menu.classList.contains("open") && !menu.contains(e.target) && e.target !== btn) setOpen(false);
  });
  document.addEventListener("keydown", function (e) {
    if (e.key === "Escape" && menu.classList.contains("open")) { setOpen(false); btn.focus(); }
  });
})();
</script>
</body>
</html>
